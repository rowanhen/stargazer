{
  "name": "@shepherd-terminal/stargazer",
  "version": "0.1.0",
  "description": "CLI tool for querying astrological events - moon phases, planetary aspects, ingresses, retrogrades, and eclipses",
  "type": "module",
  "bin": {
    "stargazer": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "validate": "bun run scripts/validate-horizons.ts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "keywords": [
    "astrology",
    "astronomy",
    "moon",
    "planets",
    "ephemeris",
    "cli",
    "retrograde",
    "eclipse"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rowanhen/stargazer.git"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
